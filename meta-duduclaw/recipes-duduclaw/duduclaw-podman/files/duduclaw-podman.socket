# API socket for the gateway's rootless Podman (2026-10-15, WP-O2).
#
# The gateway reaches it through DOCKER_HOST (bollard) and CONTAINER_HOST
# (podman CLI and its `docker` shim, which switch to remote mode when it is
# set); see duduclaw-gateway.service. Socket activation starts
# duduclaw-podman.service on the first connection.
#
# Owner-only (0600, uid 1000): the gateway and its children are the only
# intended clients. Root can still connect (root shells get CONTAINER_HOST
# from /etc/profile.d/duduclaw-podman.sh so an operator's `podman pull`
# lands in the gateway's store, not in a root store nobody uses).
#
# The parent directory /run/duduclaw-podman is root-owned 0711
# (tmpfiles.d/duduclaw-podman.conf, sysinit, before sockets start): uid 1000
# can reach the socket by name but cannot remove it or put its own listener
# at that path, so a root shell's `podman` (CONTAINER_HOST) always talks to
# this systemd-held socket. Until 2026-10-15 review it lived under
# /run/duduclaw-gateway, which uid 1000 owns.
#
# Normal default dependencies (listens before basic.target). Ordering behind
# duduclaw-home-owner.service is on the service, not here: that unit runs
# after basic.target, so ordering a socket behind it would be a cycle.
[Unit]
Description=Rootless Podman API socket for the DuDuClaw gateway

[Socket]
ListenStream=/run/duduclaw-podman/podman.sock
SocketUser=duduclaw
SocketGroup=duduclaw
SocketMode=0600
DirectoryMode=0711

[Install]
WantedBy=sockets.target
