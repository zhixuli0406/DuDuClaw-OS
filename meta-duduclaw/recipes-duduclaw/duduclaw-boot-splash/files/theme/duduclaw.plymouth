# DuDuClaw OS boot splash (C1 identity, 2026-10-16).
#
# A plain two-step theme: two-step is built unconditionally by plymouth
# 24.004.60 (src/plugins/splash/meson.build), so this theme needs no
# PACKAGECONFIG of its own. Composition, top to bottom on a flat #0B1E33:
#   watermark.png   the C1 cat mark, cream ink + amber tail, 168 px, centred
#   throbber-*.png  36-frame amber arc on a faint cream track, 32 px
# Images are generated by scripts/brand/derive-c1-assets.py; do not edit.
#
# lock.png / entry.png / bullet.png are REQUIRED by two-step (plugin.c
# refuses to load without them) and draw the password prompt, e.g. for a
# systemd-cryptsetup passphrase asked through systemd-ask-password-plymouth.
# keyboard.png / capslock.png are optional and deliberately absent: the
# plugin skips those indicators when the files are missing.
#
# Alignment math (two-step's own): an image of height h is placed at
# y = H * a - h * a, so the watermark sits slightly above centre and the
# throbber below it at any resolution.
[Plymouth Theme]
Name=DuDuClaw OS
Description=DuDuClaw OS boot splash: the cat mark on navy with a small spinner.
ModuleName=two-step

[two-step]
Font=Sans 12
TitleFont=Sans 20
ImageDir=/usr/share/plymouth/themes/duduclaw
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.70
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.70
HorizontalAlignment=.5
VerticalAlignment=.62
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b1e33
BackgroundEndColor=0x0b1e33
ProgressBarBackgroundColor=0x24405f
ProgressBarForegroundColor=0xcc8b2d
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
