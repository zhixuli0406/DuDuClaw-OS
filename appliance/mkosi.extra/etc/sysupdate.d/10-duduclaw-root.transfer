# A/B root partition update transfer (systemd-sysupdate).
#
# Source is a local staging directory, not a remote URL: fetching and
# verifying the payload is our own job (H3d), because sysupdate does NO
# integrity or authenticity checking at all for `Type=regular-file` sources —
# sysupdate.d(5) v257 says so in as many words ("When updating no integrity
# or authentication verification is done for resources of this type"), and
# there is no switch to turn it on. Whatever puts bytes into
# /var/lib/duduclaw/updates/ must therefore have verified them already
# (SHA-256 + minisign, pinned pubkey, fail-closed) before they land there.
#
# FILE EXTENSION (H3a, 2026-08-23): `.transfer`, not `.conf`. v257's search
# path is `<dir>/*.transfer`; a `.conf` file is still loaded but prints
# "As of v257, transfer definitions should have the '.transfer' extension."
# on every invocation (verified first-hand by running systemd-sysupdate
# 257.13 against both extensions — the design doc's stronger claim that a
# `.conf` file is silently ignored is NOT what this version does).
#
# InstancesMax=2 matches the fixed two-slot layout in mkosi.repart/
# (20-root-a.conf / 21-root-b.conf) — sysupdate never tries to keep more
# than the two pre-allocated slots.
#
# The whole shape below was live-fire verified before being committed: a
# scratch GPT (esp + two Type=root slots labelled `duduclaw-os_0.1.0` and
# `_empty`) on a loop device, driven by a real `systemd-sysupdate update`
# with these exact directives. Result: payload written into the empty slot,
# label rewritten to the new version, attributes matching slot A, and `list`
# reporting 0.2.0 current / 0.1.0 installed.
[Transfer]
# %A is the running image's IMAGE_VERSION from /usr/lib/os-release (our image
# has IMAGE_VERSION="0.1.0", set from mkosi.version). It stops the vacuuming
# pass from ever reclaiming the slot the machine is currently running out of,
# which is the same slot rollback has to fall back to. Note the failure mode
# if IMAGE_VERSION is ever missing: sysupdate logs "ProtectVersion= string is
# not valid, ignoring" and carries on unprotected, so this is a directive
# worth re-checking whenever os-release generation changes.
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/duduclaw/updates
# %a is the systemd architecture specifier and expands to the same names the
# GPT type table uses (`arm64`, `x86-64`), so one file serves both build
# targets and the payload name states which architecture it is for. Verified
# by matching a real `..._1.0.root-arm64.raw` on an aarch64 host. This
# replaces a hardcoded `root-x86-64`, which on the arm64 images actually
# being built matched nothing.
MatchPattern=duduclaw-os_@v.root-%a.raw

[Target]
Type=partition
Path=auto
# Matched against the partition LABEL — which is why slot A is labelled
# `duduclaw-os_0.1.0` and slot B `_empty` (mkosi.repart/). The previous
# labels (`duduclaw-root-a`/`-b`) matched this pattern never, so sysupdate
# saw zero installed instances and no free slot.
MatchPattern=duduclaw-os_@v
# The generic `root` alias, NOT `root-x86-64`. systemd resolves it to the
# running machine's native root type, exactly like `Type=root` in
# mkosi.repart/ does at build time, so one file is correct on both
# architectures. Do NOT try to write `root-%a` here: MatchPartitionType= does
# not do specifier expansion, and a value it cannot parse is *ignored with a
# warning* and silently falls back to `linux-generic` — which on this layout
# is the /data partition. Verified: `root-%a` logs "Failed parse partition
# type, ignoring".
MatchPartitionType=root
# Attribute handling for the slot just written. PartitionFlags= is the base
# value and the three tri-state directives below override individual bits, so
# this spells out a complete, deterministic attribute set rather than
# inheriting whatever the slot had:
#   PartitionNoAuto=0          clear the no-auto bit that mkosi.repart set on
#                              the factory-empty slot B — without this, the
#                              freshly written slot stays invisible to
#                              discoverable-partitions tooling forever.
#   ReadOnly=0                 tracks mkosi.repart/20-root-a.conf's
#                              `ReadOnly=no`; flip both together when the
#                              read-only-root hardening lands.
#   PartitionGrowFileSystem=1  matches slot A's bit 59, so both slots carry
#                              identical attributes after any update.
# Measured result on the live-fire run: slot B went 0x9000000000000000 →
# 0x0800000000000000, byte-identical to slot A.
PartitionFlags=0
PartitionNoAuto=0
ReadOnly=0
PartitionGrowFileSystem=1
InstancesMax=2
