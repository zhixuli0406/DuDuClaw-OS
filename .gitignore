# --- Yocto / kas build output (regenerable, large) ---
meta-duduclaw/.build/
meta-duduclaw/build/
appliance/.build/
appliance/.vm/
appliance/mkosi.output/
appliance/mkosi.cache/
appliance/.yocto-build-logs/
appliance/.yocto-cache/

# --- Release artifacts staged locally by scripts/release-os.sh ---
# (compressed image + sha256 + minisig + manifest; published to GitHub
# Releases, never committed to the repo)
/artifacts/

# --- Secure Boot / signing key material — NEVER commit ---
/sb-keys/

# --- Flatpak offline repo tarball (regenerate with gen-flatpak-offline-repo.sh) ---
# Only this path is ignored; other vendored *.tar.zst recipe sources (e.g.
# recipes-security/gitleaks/files/) ARE tracked, so no blanket *.tar.zst.
meta-duduclaw/recipes-duduclaw/duduclaw-flatpak-offline-repo/files/*.tar.zst

# --- misc ---
.DS_Store

# --- L3 Confidential trees (same convention as the DuDuClaw platform repo) ---
# Design docs / roadmaps / commercial / competitive / research notes never
# enter this public repo. The OS design docs currently live in the platform
# maintainers' private commercial/ tree; if any are ever copied here they
# go under these ignored paths only. See CLAUDE.md
# "Documentation Classification & Placement".
/commercial/
/research/

# --- AI runtime bundle tarball (regenerate with gen-ai-runtimes-bundle.sh) ---
# ~600 MB of third-party vendor binaries; reproducible from the generator
# plus the versions pinned in its MANIFEST.txt, so it stays out of git for
# the same reason the flatpak offline repo does.
meta-duduclaw/recipes-duduclaw/duduclaw-ai-runtimes/files/*.tar.zst
meta-duduclaw/recipes-duduclaw/duduclaw-ai-runtimes/files/*.tar.zst.sha256

# kas layer checkouts + bitbake build dir live at the repo root (kas fetches them here); never commit
/bitbake/
/build/
/openembedded-core/
/meta-yocto/
/meta-virtualization/
/meta-openembedded/
# release-os.sh smoke logs
.release-os-smoke-*.log

# --- Documentation site (docs-site/) build state ---
# The Starlight content tree is generated from two repos by
# docs-site/scripts/sync-docs.mjs on every build, and _site/ is the assembled
# website/ + docs-site/dist output produced by scripts/build-site.sh. All four
# are reproducible; none belongs in git.
/_site/
docs-site/node_modules/
docs-site/dist/
docs-site/src/content/docs/
docs-site/src/start-links.json
docs-site/.astro/

# --- Cloud Run staging copy of _site/ (scripts/deploy-cloudrun.sh) ---
deploy/cloudrun/_site/
