# DuDuClaw privileged system helper (duduclaw-sysd) -- Yocto bring-up unit.
#
# Adapted from appliance/mkosi.extra/etc/systemd/system/duduclaw-sysd.service
# (the Debian appliance line's verified unit) with one deliberate
# simplification for this Y2-1 bring-up stage: no `--allowed-uid` flag.
# The Yocto image doesn't provision a non-root `duduclaw` service user yet
# (that's product-layer work for a later ticket, not part of "does the
# binary build+boot+listen"), and duduclaw-sysd's own startup path treats a
# missing --allowed-uid as a legal, fail-closed boot -- it still binds and
# listens on the socket (this ticket's QEMU acceptance line), it just denies
# every connection until a uid is configured. See crates/duduclaw-sysd/src/
# main.rs's own doc comment: "Omitting BOTH is a legal startup ... denies
# every single connection -- fail-closed, not fail-to-boot."
#
# Once the Yocto layer provisions its own `duduclaw` user (mirroring
# appliance/postinst.d/20-users-and-units.sh's fixed uid 1000), add
# `--allowed-uid 1000` back here in the same commit as that user's creation
# -- tracked as an explicit TODO, not silently deferred.
[Unit]
Description=DuDuClaw privileged system helper (Yocto bring-up)

[Service]
Type=simple
User=root
RuntimeDirectory=duduclaw
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/duduclaw-sysd
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
