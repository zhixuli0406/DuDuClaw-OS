# Wired DHCP. Wi-Fi is handled by its sibling 25-wireless-dhcp.network as of
# 2026-08-23 (D4a) -- this file is no longer the only networking story, so
# nothing here should be read as "wireless is out of scope" any more.
# Match any wired NIC by both name-glob and link type so this works across
# different mini-PC hardware without per-board tuning. Kept strictly ASCII:
# a non-ASCII byte anywhere in this file (even in a comment) has been seen to
# make systemd-networkd skip the whole file, leaving the NIC unmanaged with
# no DHCP -- which is exactly the "dashboard unreachable" failure it caused.
[Match]
Name=en* eth*
Type=ether

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCP]
# Router-provided NTP servers are merged with systemd-timesyncd's own
# fallback list; this feeds timesyncd, it does not disable it.
UseNTP=yes
UseDNS=yes
# D4b (2026-08-23) -- both links stay up and the ROUTE METRIC decides which
# one carries traffic, rather than one of them being switched off. Lower wins,
# so wired (100) beats wireless (600, see 25-wireless-dhcp.network) whenever a
# cable is plugged in, and unplugging it falls back to Wi-Fi with no operator
# action. This is the macOS/Windows convention and it is what the settings
# app's network page tells the operator is happening. networkd's own default
# for both would be 1024, i.e. a tie broken arbitrarily.
# The static-IP drop-in duduclaw-sysd writes to /run/systemd/network/ carries
# the same Metric=100 on its [Route], so switching a box to a fixed address
# does not change which link is preferred.
RouteMetric=100
